---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import type { Locale } from '../../i18n/ui';
import { localePath, t } from '../../i18n/utils';
import { getPosts } from '../../utils/posts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tr = (key: Parameters<typeof t>[1]) => t(locale, key);

const posts = await getPosts(locale);
const latest = posts.slice(0, 5);
---

<BaseLayout
  title={tr('site.title')}
  description={tr('site.description')}
  locale={locale}
  translated
>
  <section class="mb-12">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-slate-50">
      {tr('site.title')}
    </h1>
    <p class="mt-3 text-base text-slate-600 dark:text-slate-300">{tr('site.description')}</p>
    <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{tr('site.tagline')}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href={localePath(locale, 'posts/')}
        class="inline-flex h-10 items-center rounded-md bg-sky-600 px-4 text-sm font-medium text-white transition-colors hover:bg-sky-700"
      >
        {tr('home.allPosts')}
      </a>
      <a
        href={localePath(locale, 'resume/')}
        class="inline-flex h-10 items-center rounded-md border border-slate-200 px-4 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
      >
        {tr('home.viewResume')}
      </a>
    </div>
  </section>

  <section>
    <h2 class="mb-4 text-lg font-semibold text-slate-900 dark:text-slate-50">
      {tr('home.latestPosts')}
    </h2>
    <PostList posts={latest} locale={locale} emptyText={tr('home.empty')} />
    {posts.length > latest.length && (
      <p class="mt-6 text-sm">
        <a
          href={localePath(locale, 'posts/')}
          class="text-sky-600 transition-colors hover:text-sky-700 dark:text-sky-400 dark:hover:text-sky-300"
        >
          {tr('home.allPosts')} →
        </a>
      </p>
    )}
  </section>
</BaseLayout>
