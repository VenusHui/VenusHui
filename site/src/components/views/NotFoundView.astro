---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { defaultLocale, type Locale } from '../../i18n/ui';
import { localePath, t } from '../../i18n/utils';

/**
 * 404 是单份静态文件（构建成 /404.html），无法按 URL 判断语言，
 * 因此两种语言的提示都列出来并给出各自的入口，不用 JS 猜。
 */
const primary: Locale = defaultLocale;
const secondary: Locale = primary === 'zh' ? 'en' : 'zh';
const both: Locale[] = [primary, secondary];
---

<BaseLayout
  title={t(primary, 'notFound.title')}
  description={t(primary, 'notFound.description')}
  locale={primary}
  noindex
  languageHref={localePath(secondary)}
>
  <div class="space-y-10">
    {/*
      有趣的 404 辨识：大号等宽编号 + 一行「编译器错误」式提示，克制不喧宾夺主。
      这个编号是本页唯一的 h1：两段语言提示各自是 section + h2，若都不给 h1，
      文档大纲会缺根（屏幕阅读器按标题导航会跳空）。
    */}
    <div data-reveal class="text-center">
      <h1 class="font-mono text-6xl font-bold leading-none tracking-tight text-ink">
        <span class="text-accent">4</span>0<span class="text-accent">4</span>
      </h1>
      <p class="mt-4 font-mono text-sm text-ink-3">
        <span class="text-accent">error[E404]</span>: page not found
      </p>
    </div>

    {both.map((locale) => (
      <section class="rounded-lg border border-line bg-surface px-6 py-6">
        <h2 class="text-lg font-semibold text-ink">{t(locale, 'notFound.title')}</h2>
        <p class="mt-2 text-sm text-ink-2">{t(locale, 'notFound.description')}</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href={localePath(locale)} class="btn-primary">
            {t(locale, 'notFound.backHome')}
          </a>
          <a href={localePath(locale, 'posts/')} class="btn-secondary">
            {t(locale, 'notFound.browsePosts')}
          </a>
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
