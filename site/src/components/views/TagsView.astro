---
import PageHeader from '../PageHeader.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n/ui';
import { localePath, t } from '../../i18n/utils';
import { getPosts, groupByTag } from '../../utils/posts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const tags = groupByTag(await getPosts(locale));
---

<BaseLayout
  title={t(locale, 'tags.title')}
  description={t(locale, 'tags.description')}
  locale={locale}
  translated
>
  <PageHeader title={t(locale, 'tags.title')} description={t(locale, 'tags.description')} />

  {tags.length === 0 ? (
    <p class="text-sm text-ink-3">{t(locale, 'tags.empty')}</p>
  ) : (
    <ul class="flex flex-wrap gap-3">
      {tags.map((group) => (
        <li>
          <a href={localePath(locale, `tags/${group.slug}/`)} class="chip px-3 py-1 text-sm">
            {group.tag}
            <span class="text-xs text-ink-3">
              {group.posts.length} {t(locale, 'tags.count')}
            </span>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
