---
import PageHeader from '../PageHeader.astro';
import SectionHeading from '../SectionHeading.astro';
import PostCard from '../PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Locale } from '../../i18n/ui';
import { t } from '../../i18n/utils';
import { getPosts, groupBySeries, seriesLabel } from '../../utils/posts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const groups = groupBySeries(await getPosts(locale));
const total = groups.reduce((sum, group) => sum + group.posts.length, 0);
---

<BaseLayout
  title={t(locale, 'posts.title')}
  description={t(locale, 'posts.description')}
  locale={locale}
  translated
>
  <PageHeader
    title={t(locale, 'posts.title')}
    description={t(locale, 'posts.description')}
    eyebrow="posts"
  />

  {groups.length === 0 ? (
    <p class="text-sm text-ink-3">{t(locale, 'posts.empty')}</p>
  ) : (
    <div>
      {groups.map((group, index) => (
        <section id={group.series || undefined} class="mt-12 first:mt-0">
          {/*
            系列分节标题：与首页「最新博文」同款（序号 + 标题 + 等宽计数 + 分隔线），
            只渲染数据里真实存在的系列，列表本身不硬编码系列名。
          */}
          <SectionHeading
            index={String(index + 1).padStart(2, '0')}
            title={seriesLabel(group.series, locale)}
            count={group.posts.length.toString().padStart(2, '0')}
          />
          {group.posts.map((post) => (
            <PostCard post={post} locale={locale} />
          ))}
        </section>
      ))}
      <p class="mt-8 border-t border-line pt-4 font-mono text-xs text-ink-3">
        {total.toString().padStart(2, '0')} {t(locale, 'archive.count')}
      </p>
    </div>
  )}
</BaseLayout>
