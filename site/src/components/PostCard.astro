---
import type { Locale } from '../i18n/ui';
import { localePath, t } from '../i18n/utils';
import { formatDate, postPath, readingTime, tagSlug, type Post } from '../utils/posts';

interface Props {
  post: Post;
  locale: Locale;
}

const { post, locale } = Astro.props;
const { title, date, summary, tags } = post.data;
---

<article class="group relative border-b border-line py-6 transition-colors first:pt-0 last:border-b-0 hover:bg-surface">
  {/*
    hover 微交互：左侧一条主色竖线纵向展开；配合标题下划线动画，
    让列表项在不动布局的前提下有「可点」的反馈。
  */}
  <span
    aria-hidden="true"
    class="absolute inset-y-6 left-0 w-0.5 scale-y-0 bg-accent transition-transform duration-300 group-hover:scale-y-100"
  ></span>
  <div class="pl-0 transition-transform duration-300 group-hover:translate-x-1">
    <h3 class="text-lg font-semibold leading-snug">
      <a href={postPath(post)} class="link-underline text-ink hover:text-accent">
        {title}
      </a>
    </h3>
    <p class="mt-1.5 flex items-center gap-x-3 font-mono text-xs text-ink-3">
      <time datetime={date.toISOString()}>{formatDate(date, locale)}</time>
      <span aria-hidden="true" class="text-ink-3">
        ·
      </span>
      <span>
        {readingTime(post.body)} {t(locale, 'posts.readingTime')}
      </span>
    </p>
    <p class="mt-2 text-sm leading-relaxed text-ink-2">{summary}</p>
    {tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <li>
            <a href={localePath(locale, `tags/${tagSlug(tag)}/`)} class="chip">
              {tag}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
