---
import { AUTHOR, REPO_URL } from '../consts';
import { rssPath } from '../i18n/rss';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
// 构建时取年份；站点每次发布都会重新构建，年份随之更新。
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 dark:border-slate-800">
  <div class="mx-auto flex w-full max-w-3xl flex-wrap items-center gap-x-4 gap-y-2 px-4 py-6 text-sm text-slate-500 sm:px-6 dark:text-slate-400">
    <p>
      © {year} {AUTHOR}. {t(locale, 'footer.rights')}
    </p>
    <div class="ml-auto flex items-center gap-4">
      <a
        href={rssPath(locale)}
        class="transition-colors hover:text-sky-600 dark:hover:text-sky-400"
      >
        {t(locale, 'footer.rss')}
      </a>
      <a
        href={REPO_URL}
        rel="noopener noreferrer"
        class="transition-colors hover:text-sky-600 dark:hover:text-sky-400"
      >
        {t(locale, 'footer.source')}
      </a>
    </div>
  </div>
</footer>
