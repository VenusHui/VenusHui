---
import { AUTHOR, REPO_URL } from '../consts';
import { rssPath } from '../i18n/rss';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
// 构建时取年份；站点每次发布都会重新构建，年份随之更新。
const year = new Date().getFullYear();
---

<footer class="border-t border-line print:hidden">
  <div class="mx-auto w-full max-w-3xl px-4 py-8 sm:px-6">
    {/*
      终端签名：`~/venushui $ exit 0` —— 站点「终端即视感」收尾。
      只影响视觉，不承载信息，保持克制。
    */}
    <p class="font-mono text-xs text-ink-3">
      <span class="text-accent">~/</span>
      {t(locale, 'site.title').toLowerCase()}
      <span class="text-ink-3">$</span> exit 0
    </p>

    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-ink-3">
      <p>
        © {year} {AUTHOR}. {t(locale, 'footer.rights')}
      </p>
      <div class="ml-auto flex items-center gap-4">
        <a href={rssPath(locale)} class="link-underline hover:text-accent">
          {t(locale, 'footer.rss')}
        </a>
        <a href={REPO_URL} rel="noopener noreferrer" class="link-underline hover:text-accent">
          {t(locale, 'footer.source')}
        </a>
      </div>
    </div>
  </div>
</footer>
