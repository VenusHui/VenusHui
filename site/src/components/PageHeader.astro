---
/** 页面级标题区，列表页与详情页共用，保证排版一致。 */
interface Props {
  title: string;
  description?: string;
  /** 眉题：站点路径写法（如 `posts`），渲染成 `~/posts`，不传则不显示。 */
  eyebrow?: string;
}

const { title, description, eyebrow } = Astro.props;
---

<header class="mb-10" data-reveal>
  {/*
    眉题：等宽字 + 主色 `~/`，延续终端路径即视感；让每个页面都有
    「我在哪」的层级感，而不是从 h1 直接开始。
  */}
  {eyebrow && (
    <p class="font-mono text-sm text-ink-3">
      <span class="text-accent">~/</span>
      {eyebrow}
    </p>
  )}
  <h1 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl">{title}</h1>
  {description && (
    <p class="mt-3 max-w-prose text-base leading-relaxed text-ink-2">{description}</p>
  )}
</header>
