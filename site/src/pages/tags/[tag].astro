---
import TagView from '../../components/views/TagView.astro';
import { getPosts, groupByTag } from '../../utils/posts';

// 只为「该语言下真的有博文」的标签生成页面，避免产出空页面或被 hreflang 指向的无效页。
export async function getStaticPaths() {
  const groups = groupByTag(await getPosts('zh'));
  return groups.map((group) => ({ params: { tag: group.slug }, props: { tag: group.tag } }));
}

const { tag } = Astro.props;
---

<TagView tag={tag} locale="zh" />
