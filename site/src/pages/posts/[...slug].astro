---
import { render } from 'astro:content';
import PostView from '../../components/views/PostView.astro';
import { getPosts } from '../../utils/posts';

// 必须走 getPosts()（语言过滤 + 草稿闸门都在里面）。
// 直接 getCollection('posts', ...) 会绕过草稿闸门，把 draft 正文构建出来并写进 sitemap。
export async function getStaticPaths() {
  const posts = await getPosts('zh');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<PostView post={post} Content={Content} locale="zh" />
